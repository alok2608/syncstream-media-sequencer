# PostgreSQL connection string (required).
# Local:  postgres://postgres:postgres@localhost:5432/sequencer?sslmode=disable
# Neon:   postgres://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sequencer?sslmode=disable

# Port to listen on. Render sets this automatically.
PORT=8080

# Comma-separated CORS / WebSocket origin allow-list. Use "*" to allow any origin.
# Production example: https://your-app.vercel.app
#
# Any http://localhost, 127.0.0.1 or [::1] origin is accepted on ANY port in
# addition to this list, so a Vite dev server that falls back to 5174 still
# works. Set ALLOW_LOOPBACK_ORIGINS=false to require an exact match.
FRONTEND_URL=http://localhost:5173

# How far in the future a global sync is scheduled, giving every connected
# client time to receive the event and preload before the shared start instant.
SYNC_LEAD_TIME_MS=1000

# Seed the demo dataset on boot when the database has no windows yet.
AUTO_SEED=true

# HTTP access logging.
LOG_REQUESTS=true

# Optional: base URL for the seed videos. Defaults to /api/assets, i.e. the demo
# clips bundled into this backend's own binary, so the demo needs no media host.
# SEED_VIDEO_BASE_URL=https://cdn.example.com/media
